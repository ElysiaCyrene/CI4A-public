{
  "name": "ci4a-release",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:components": "node scripts/dev.mjs components",
    "dev:webarena": "node scripts/dev.mjs webarena",
    "build": "pnpm --filter \"ci4a-webarena-*\" --filter \"ci4a-components-*\" -r build",
    "build:materialx": "node scripts/build-materialx.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "setup": "powershell -NoProfile -File scripts/setup.ps1",
    "audit:release": "python scripts/release_audit.py"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@vue/babel-plugin-jsx": "1.5.0",
    "@vitejs/plugin-react": "5.1.0",
    "@vitejs/plugin-vue": "6.0.1",
    "dotenv": "17.2.3",
    "playwright": "1.56.0",
    "vite": "7.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ant-design-vue": "workspace:*",
      "element-plus": "workspace:*",
      "@mui/material": "workspace:*",
      "@mui/system": "workspace:*",
      "@mui/utils": "workspace:*",
      "@mui/types": "workspace:*",
      "@mui/private-theming": "workspace:*",
      "@mui/styled-engine": "workspace:*",
      "@mui/core-downloads-tracker": "workspace:*",
      "@mui/icons-material": "workspace:*"
    }
  }
}
